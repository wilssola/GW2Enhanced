{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GW2 Enhanced",
  "mainBinaryName": "GW2Enhanced-Installer",
  "version": "0.1.0",
  "identifier": "com.wilssola.gw2enhanced.installer",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GW2 Enhanced",
        "width": 1120,
        "height": 700,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#14100d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
